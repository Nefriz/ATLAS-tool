# Your local FastAPI, accessible from the browser
VITE_API_URL=http://127.0.0.1:8000

# Comma-separated folder names for your FastAPI endpoint /worlds/{world_id}
VITE_WORLD_IDS=Potato - 8

# Set true to use real API first; if unavailable, app starts in Season 8 demo
VITE_AUTO_CONNECT=true

# Used when backend WorldScheme doesn't expose grid_size
VITE_DEFAULT_GRID_SIZE=1400000
